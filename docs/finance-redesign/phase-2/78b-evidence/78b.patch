+/**
+ * Ranks catalogue items against a free-text BOM description (Report 78B).
+ *
+ * A typed requirement rarely matches a catalogue name as one substring
+ * ("MDF 18mm board (typed)" vs "MDF Board 18mm"), so the search is by word:
+ * every shared word scores, and shared numbers — sizes, thicknesses — score
+ * double, because they are what separates 18mm from 9mm. This only orders
+ * suggestions; whether a unit can be read is the server's answer.
+ */
+const tokens = (value: string): string[] =>
+  String(value || '')
+    .toLowerCase()
+    .replace(/(\d)([a-z])/g, '$1 $2')
+    .replace(/([a-z])(\d)/g, '$1 $2')
+    .replace(/[^\p{L}\p{N}.]+/gu, ' ')
+    .split(' ')
+    .map(token => token.replace(/^\.+|\.+$/g, ''))
+    .filter(token => token.length > 0)
+
+const isNumber = (token: string) => /^\d+(\.\d+)?$/.test(token)
+
+export const rankCatalogue = <T extends { material_name?: string; material_code?: string; category?: string }>(
+  items: T[],
+  query: string,
+  limit = 30,
+): T[] => {
+  const wanted = [...new Set(tokens(query))].filter(token => isNumber(token) || token.length >= 2)
+  if (!wanted.length) return []
+
+  return items
+    .map(item => {
+      const haystack = tokens(`${item.material_name ?? ''} ${item.material_code ?? ''} ${item.category ?? ''}`)
+      const code = String(item.material_code ?? '').toLowerCase()
+      let score = 0
+      for (const token of wanted) {
+        if (haystack.includes(token)) score += isNumber(token) ? 2 : 1
+        else if (!isNumber(token) && token.length >= 3 && haystack.some(word => word.startsWith(token))) score += 0.5
+      }
+      if (code && query.trim().toLowerCase() === code) score += 10
+      return { item, score }
+    })
+    .filter(entry => entry.score > 0)
+    .sort((a, b) => b.score - a.score || String(a.item.material_name).localeCompare(String(b.item.material_name)))
+    .slice(0, limit)
+    .map(entry => entry.item)
+}
