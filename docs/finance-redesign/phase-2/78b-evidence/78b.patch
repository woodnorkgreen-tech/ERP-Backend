+const catalogue = [
+  { id: 1, material_name: 'MDF Board 9mm', material_code: 'BRD-009' },
+  { id: 2, material_name: 'MDF Board 18mm', material_code: 'BRD-018' },
+  { id: 3, material_name: 'Contact Adhesive 1L', material_code: 'ADH-001' },
+]
+
+describe('rankCatalogue', () => {
+  it('finds a catalogue item from a typed BOM description, best size match first', () => {
+    const ranked = rankCatalogue(catalogue, 'MDF 18mm board (typed)')
+    expect(ranked.map(item => item.id)).toEqual([2, 1])
+  })
+
+  it('ranks by shared size, so a similar name with a different size comes second', () => {
+    expect(rankCatalogue(catalogue, 'board 9 mm')[0].id).toBe(1)
+  })
+
+  it('matches an exact code', () => {
+    expect(rankCatalogue(catalogue, 'ADH-001')[0].id).toBe(3)
+  })
+
+  it('returns nothing for an empty query', () => {
+    expect(rankCatalogue(catalogue, '   ')).toEqual([])
+  })
+})
